<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.2" xmlns="https://jakarta.ee/xml/ns/persistence">
  <persistence-unit name="timetablingPU" transaction-type="RESOURCE_LOCAL">
    <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
    <class>com.kleberandrade.committeetimetable.model.Course</class>
    <class>com.kleberandrade.committeetimetable.model.Degree</class>
    <class>com.kleberandrade.committeetimetable.model.Expertise</class>
    <class>com.kleberandrade.committeetimetable.model.Professor</class>
    <class>com.kleberandrade.committeetimetable.model.Committee</class>
    <class>com.kleberandrade.committeetimetable.model.Project</class>
    <class>com.kleberandrade.committeetimetable.model.Student</class>
    <class>com.kleberandrade.committeetimetable.model.Schedule</class>
    <class>com.kleberandrade.committeetimetable.model.ProjectType</class>
    <exclude-unlisted-classes>true</exclude-unlisted-classes>
    <properties>
      <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>
      <property name="hibernate.hbm2ddl.auto" value="validate"/>
      <property name="hibernate.show_sql" value="false"/>
      <property name="hibernate.id.db_structure_naming_strategy" value="legacy"/>
      <property name="hibernate.mapping.default_list_semantics" value="BAG"/>
    </properties>
  </persistence-unit>
</persistence>
